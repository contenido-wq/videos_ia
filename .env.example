# Copiá este archivo a .env y completá tus propias claves.
# No se comparten entre personas — cada quien usa las suyas.
# Ver el README (tabla "Configurar tu .env") para saber cuáles necesitás
# según el estilo de video que vayas a usar (vox / ranking / pantalla dividida).

# Siempre requerida — transcripción de audio y generación de voz
ELEVENLABS_API_KEY=

# Requerida por ranking y pantalla dividida — detecta y corta tomas
# fallidas/muletillas en el video que grabaste
ANTHROPIC_API_KEY=

# Opcional — solo si vox genera imágenes con IA/personaje, o si ranking no
# encuentra el logo en ninguna otra fuente (último recurso de la cascada)
KIE_AI_API_KEY=

# Opcionales (van juntas) — solo si vox usa fotos reales, o si ranking cae
# en la etapa de búsqueda de logos por Google Images
APIFY_API_TOKEN=
APIFY_GOOGLE_IMAGES_TASK=

# Opcional — primer eslabón de la cascada de logos en ranking, antes de caer
# a Apify/Google Images. Si no está seteada, simplemente se salta este paso.
LOGO_DEV_API_KEY=
