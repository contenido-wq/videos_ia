node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Videos crudos subidos por el usuario (pesados, personales, no son assets finales)
content/raw

# Videos crudos/intermedios generados por el pipeline (pesados, no son assets
# finales — sacados del historial una vez porque bloqueaban el push a GitHub)
public/assets/*/video/

# Video "nepal" (youtube-noticias-avatar): 168 imágenes en alta resolución,
# ~4.4GB entre el original y la copia que hace el pipeline — no se comitea
# (decisión explícita, 2026-08-30). Regenerable con generate:assets si se
# tiene el guion (sí versionado) + las imágenes originales a mano.
content/personajes/nepal/
public/assets/nepal/images/

# Video "primeros-humanos-de-noche" (documental-doodle): 224 imágenes IA +
# 19 audios generados, ~237MB — no se comitea (decisión explícita,
# 2026-09-02). Regenerable con generate:assets a partir del guion (sí
# versionado en content/guiones/).
public/assets/primeros-humanos-de-noche/

# Claude Code local state (git worktrees, local-only permissions) —
# excepto .claude/skills/, que sí se versiona: son las Skills por estilo
# de video que se comparten con el repo (ver .claude/skills/*/SKILL.md).
.claude/*
!.claude/skills/

# Git worktrees usados para aislar trabajo de implementación (superpowers:using-git-worktrees).
.worktrees/

# Carpeta de trabajo suelta "Nepal/" en la raíz (imágenes + video de avatar,
# ~1.7GB incluyendo un .mp4 de 248MB) — supera el límite de 100MB de GitHub
# y son assets crudos regenerables, no assets finales versionados.
/Nepal/

# Output de `analyze:channel` (reporte.pdf, imágenes de personaje, guías
# derivadas) — regenerable corriendo el comando de nuevo, y a veces es de
# canales de terceros usados solo como referencia/prueba, no assets propios.
content/canales/
