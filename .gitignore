node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Videos crudos subidos por el usuario (pesados, personales, no son assets finales)
content/raw

# Videos crudos/intermedios generados por el pipeline (pesados, no son assets
# finales — sacados del historial una vez porque bloqueaban el push a GitHub)
public/assets/*/video/

# Claude Code local state (git worktrees, local-only permissions) —
# excepto .claude/skills/, que sí se versiona: son las Skills por estilo
# de video que se comparten con el repo (ver .claude/skills/*/SKILL.md).
.claude/*
!.claude/skills/
